# 数据目录的本地路径
DATA_DIR=/path/to/your/data

# 管理员登录鉴权（设置密码后开启，管理操作与目录浏览都需登录）
# FM_USER=admin
# FM_PASS=yourpassword
# 会话签名密钥：建议设置为随机长字符串，否则重启后需重新登录
# FM_SECRET=please-change-to-a-random-string
# 可选：会话有效期（小时），默认 168（7 天）
# FM_SESSION_HOURS=168
# 兼容旧格式（user:pass），等价于 FM_USER + FM_PASS
# FM_AUTH=admin:yourpassword

# 未登录匿名查看（默认开启）：可通过直链查看单个文件，但受次数与空闲时效限制
# FM_ANON=0 可关闭，关闭后所有访问都需登录
# FM_ANON_LIMIT=20        # 时效内可查看的不同文件数上限
# FM_ANON_IDLE_MIN=30     # 空闲多少分钟后额度失活并重置
